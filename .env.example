# Application
APP_NAME=Automated Multi-Platform Posting API
APP_VERSION=1.0.0

# Existing link-analysis feature / LLM platform
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash-lite

# HTTP timeouts / content limits
REQUEST_TIMEOUT=15
MAX_CONTENT_LENGTH=30000

# Mastodon -- https://docs.joinmastodon.org/methods/statuses/
MASTODON_BASE_URL=https://mastodon.social
MASTODON_ACCESS_TOKEN=your-mastodon-access-token

# Bluesky -- use an app password, not your account password
BLUESKY_SERVICE_URL=https://bsky.social
BLUESKY_HANDLE=your-handle.bsky.social
BLUESKY_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# DEV Community (Forem)
DEVTO_API_KEY=your-devto-api-key

# Reddit -- script-type OAuth app from https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=your-reddit-client-id
REDDIT_CLIENT_SECRET=your-reddit-client-secret
REDDIT_USERNAME=your-reddit-username
REDDIT_PASSWORD=your-reddit-password
REDDIT_SUBREDDIT=test

# X API v2 -- requires a plan with POST /2/tweets write access
X_BEARER_TOKEN=your-x-bearer-token
